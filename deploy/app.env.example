# The settings of compose.prod.yaml on the server (ADR-0029). The real file, /etc/markup-resume/app.env, is assembled
# from SSM Parameter Store at start; secrets never go into git or images.

# The domain, without https://. APP_ORIGIN and MCP_URL are built from it.
SITE_ADDRESS=resume.example.com
# Images in ECR, tagged with the commit they were built from.
APP_IMAGE=123456789012.dkr.ecr.eu-north-1.amazonaws.com/markup-resume-app:<sha>
WEB_IMAGE=123456789012.dkr.ecr.eu-north-1.amazonaws.com/markup-resume-web:<sha>
# URL-safe, e.g. openssl rand -hex 32. Secret.
POSTGRES_PASSWORD=
# The production GitHub OAuth App, callback https://<SITE_ADDRESS>/auth/github/callback. The secret is secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub user ids that may sign in, comma-separated (the "id" in https://api.github.com/users/<login>).
ALLOWED_GITHUB_IDS=
OWNER_GITHUB_ID=
