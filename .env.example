# Copy to .env and fill in. Docker Compose reads .env; git ignores it.

# GitHub sign-in (ADR-0027): a dev OAuth App with the callback http://localhost:4200/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Your GitHub user id: the "id" in https://api.github.com/users/<your-login>. MCP (until it has its own OAuth),
# pnpm seed, import:files and claim:local-resumes act for this user, who must have signed in once.
OWNER_GITHUB_ID=
