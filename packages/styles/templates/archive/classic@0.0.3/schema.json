{
  "$comment": "The markup accepted for documents on this template; rules.md explains the same to Claude. Every element in the page carries one class from \"classes\" (plus its kind class, if it has \"oneOf\"), or no class and a tag from \"plainElements\". \"parents\": the classes of the nearest classed ancestor it may sit in; empty for the page itself. \"first\": the class of the element that must open it.",
  "plainElements": ["p", "ul", "li", "a", "strong", "time", "h3", "span"],
  "classes": {
    "resume-page": { "tags": ["main"], "parents": [] },

    "resume-header": { "tags": ["header"], "parents": ["resume-page"] },
    "resume-name": { "tags": ["h1"], "parents": ["resume-header"] },
    "resume-headline": { "tags": ["p"], "parents": ["resume-header"] },

    "resume-summary": { "tags": ["section"], "parents": ["resume-page"], "first": "resume-summary-header" },
    "resume-summary-header": { "tags": ["h2"], "parents": ["resume-summary"] },

    "resume-columns": { "tags": ["div"], "parents": ["resume-page"] },
    "resume-sidebar": { "tags": ["aside"], "parents": ["resume-columns"] },
    "resume-main": { "tags": ["div"], "parents": ["resume-columns"] },

    "resume-contacts": {
      "tags": ["section"],
      "parents": ["resume-sidebar"],
      "first": "resume-contacts-header"
    },
    "resume-contacts-header": { "tags": ["h2"], "parents": ["resume-contacts"] },
    "resume-contact-list": { "tags": ["ul"], "parents": ["resume-contacts"] },
    "resume-contact": {
      "tags": ["li"],
      "parents": ["resume-contact-list"],
      "oneOf": [
        "resume-contact-email",
        "resume-contact-phone",
        "resume-contact-linkedin",
        "resume-contact-github",
        "resume-contact-telegram",
        "resume-contact-website",
        "resume-contact-location"
      ]
    },

    "resume-skills": { "tags": ["section"], "parents": ["resume-sidebar"], "first": "resume-skills-header" },
    "resume-skills-header": { "tags": ["h2"], "parents": ["resume-skills"] },
    "resume-skill-group": { "tags": ["div"], "parents": ["resume-skills"] },
    "resume-skill-list": { "tags": ["ul"], "parents": ["resume-skill-group"] },

    "resume-education": {
      "tags": ["section"],
      "parents": ["resume-sidebar"],
      "first": "resume-education-header"
    },
    "resume-education-header": { "tags": ["h2"], "parents": ["resume-education"] },
    "resume-school": { "tags": ["article"], "parents": ["resume-education"] },
    "resume-school-name": { "tags": ["h3"], "parents": ["resume-school"] },
    "resume-degree": { "tags": ["div"], "parents": ["resume-school"] },
    "resume-degree-name": { "tags": ["p"], "parents": ["resume-degree"] },
    "resume-dates": {
      "tags": ["p"],
      "parents": ["resume-degree", "resume-employer-header", "resume-project-header"]
    },

    "resume-experience": {
      "tags": ["section"],
      "parents": ["resume-main"],
      "first": "resume-experience-header"
    },
    "resume-experience-header": { "tags": ["h2"], "parents": ["resume-experience"] },
    "resume-employer": { "tags": ["article"], "parents": ["resume-experience"] },
    "resume-employer-header": { "tags": ["div"], "parents": ["resume-employer"] },
    "resume-employer-name": { "tags": ["h3"], "parents": ["resume-employer-header"] },
    "resume-project": { "tags": ["div"], "parents": ["resume-employer"] },
    "resume-project-header": { "tags": ["div"], "parents": ["resume-project"] },
    "resume-role": { "tags": ["h4"], "parents": ["resume-project-header"] },
    "resume-domain": { "tags": ["p"], "parents": ["resume-project-header"] },
    "resume-achievements": { "tags": ["ul"], "parents": ["resume-project"] },

    "resume-languages": {
      "tags": ["section"],
      "parents": ["resume-sidebar"],
      "first": "resume-languages-header"
    },
    "resume-languages-header": { "tags": ["h2"], "parents": ["resume-languages"] },
    "resume-language-list": { "tags": ["ul"], "parents": ["resume-languages"] }
  }
}
