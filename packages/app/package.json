{
  "name": "@markup-resume/app",
  "version": "0.0.0",
  "private": true,
  "description": "Domain, use cases and adapters: storage, HTTP API, MCP server, PDF export and checks.",
  "type": "module",
  "exports": {
    "./domain": "./src/domain/index.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "seed": "node src/seed.ts",
    "db:types": "kysely-codegen --dialect postgres --out-file src/adapters/storage-pg/schema.ts --exclude-pattern 'kysely_*' && prettier --write src/adapters/storage-pg/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/*.db.test.ts'",
    "test:db": "vitest run .db.test"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@markup-resume/styles": "workspace:*",
    "@modelcontextprotocol/server": "^2.4.0",
    "hono": "^4.13.14",
    "kysely": "^0.29.7",
    "parse5": "^8.0.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
